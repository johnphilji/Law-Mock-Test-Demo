    },
    {
      "page": "/test/[testId]",
      "regex": "^/test/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtestId": "nxtPtestId"
      },
      "namedRegex": "^/test/(?<nxtPtestId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
