# Panther Law Prep — Environment Variable Reference
#
# NEVER commit real credentials to this file or to .env.local.
# This file documents all required environment variables.
# Copy to .env.local and fill in real values for local development.
#
# See docs/ENVIRONMENT.md for detailed explanations of each variable.
# =============================================================================

# =============================================================================
# APPLICATION
# =============================================================================

# The environment this instance is running in.
# MUST be set to "production" in production, "staging" in staging.
# Default: development
APP_ENVIRONMENT=development

# The public URL of the application (no trailing slash).
# Required for: email links, Razorpay callbacks, webhooks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For local Docker: postgresql://postgres:secret@localhost:5432/panther_law_prep
DATABASE_URL=

# Optional: separate read replica URL for analytics/reporting queries.
# If not set, DATABASE_URL is used for all queries.
DATABASE_READ_URL=

# =============================================================================
# AUTHENTICATION (NextAuth v5 / Auth.js)
# =============================================================================

# A random 32+ character string used to sign session tokens.
# Generate with: openssl rand -base64 32
# NEVER expose this to the client. NEVER commit this value.
AUTH_SECRET=

# =============================================================================
# RAZORPAY PAYMENTS
# =============================================================================
#
# CRITICAL ENVIRONMENT ISOLATION:
# - Development and staging MUST use rzp_test_ credentials.
# - Production MUST use rzp_live_ credentials.
# - The application validates this at startup and refuses to start if wrong.
# - This prevents accidental production charges during development.
#
# Obtain from: https://dashboard.razorpay.com → Settings → API Keys

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret for verifying Razorpay webhook signatures.
# Obtain from: Dashboard → Webhooks → Create/Edit webhook → Copy secret
RAZORPAY_WEBHOOK_SECRET=

# Exposed to the browser for Razorpay Checkout initialization.
# This is the PUBLIC key — safe to expose. Do NOT expose KEY_SECRET here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# =============================================================================
# RATE LIMITING
# =============================================================================
#
# Development: In-memory rate limiting (no Redis required).
# Staging/Production: Upstash Redis required.
#
# Obtain from: https://console.upstash.com → Create Database → REST API
#
# IMPORTANT: See docs/SECURITY.md for the rate-limit fail behavior.
# Security-sensitive endpoints NEVER fail open, regardless of this setting.
# Only explicitly classified low-risk endpoints may be configured to fail open.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Whether non-security-sensitive endpoints fail open when Redis is unavailable.
# "true" = allow request + log warning (high availability)
# "false" = return 503 + log error (strict mode)
# Default: false (strict)
# Security endpoints (auth, payment, admin) ALWAYS fail closed regardless of this setting.
RATE_LIMIT_FAIL_OPEN=false

# =============================================================================
# EMAIL (Resend)
# =============================================================================
#
# Development: Use Resend sandbox domain (onboarding@resend.dev) or Resend test mode.
# Production: Must use a verified domain (e.g. no-reply@pantherlawprep.com).
#
# Obtain API key from: https://resend.com → API Keys → Create

EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Panther Law Prep

# =============================================================================
# FILE STORAGE (Question Images)
# =============================================================================
#
# Optional: If not configured, image uploads will be disabled in the admin panel.
# Supported: AWS S3, Cloudflare R2 (S3-compatible)

STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=

# =============================================================================
# ADMIN SEED
# =============================================================================
#
# Password for the initial admin account created by the seed script.
# Only used during: npm run db:seed
# NEVER commit this value. Minimum 12 characters.

ADMIN_SEED_EMAIL=admin@pantherlawprep.com
ADMIN_SEED_PASSWORD=

# =============================================================================
# OBSERVABILITY (Optional but recommended for production)
# =============================================================================

# Sentry DSN for error tracking.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Set to "true" to enable detailed error messages in non-production environments.
# NEVER set to "true" in production.
SHOW_DETAILED_ERRORS=false
