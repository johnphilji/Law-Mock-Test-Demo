{
  "name": "panther-law-prep-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --workspace=frontend run dev",
    "build:frontend": "npm --workspace=frontend run build",
    "build:backend": "npm --workspace=backend run build",
    "build": "npm run build:frontend && npm run build:backend",
    "test": "npm --workspace=backend run test",
    "test:watch": "npm --workspace=backend run test:watch",
    "test:coverage": "npm --workspace=backend run test:coverage",
    "lint": "npm --workspace=frontend run lint",
    "typecheck": "npm --workspace=frontend run typecheck",
    "db:generate": "npm --workspace=backend run db:generate",
    "db:migrate": "npm --workspace=backend run db:migrate",
    "db:migrate:prod": "npm --workspace=backend run db:migrate:prod",
    "db:push": "npm --workspace=backend run db:push",
    "db:seed": "npm --workspace=backend run db:seed",
    "db:bootstrap-admin": "npm --workspace=backend run db:bootstrap-admin",
    "db:studio": "npm --workspace=backend run db:studio",
    "db:reset": "npm --workspace=backend run db:reset"
  }
}
