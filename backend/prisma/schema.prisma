// Prisma Schema — Panther Law Prep
// 
// Design principles:
// 1. UUIDs as primary keys (no sequential IDs exposed to clients)
// 2. All timestamps in UTC
// 3. Soft deletion via isActive/status flags — never hard-delete examination data
// 4. Question versioning for exam integrity
// 5. Immutable AttemptSnapshot for historical reproducibility
// 6. Transactions required for: payment activation, exam submission, answer saves
//
// See docs/DATABASE.md for full schema documentation and ER diagram.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  STUDENT
  ADMIN
}

enum TestType {
  MOCK
  SECTIONAL
  TOPIC
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
  // MULTIPLE_CHOICE -- reserved for future
  // NUMERICAL -- reserved for future
  // TRUE_FALSE -- reserved for future
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

// Explicit attempt state machine.
// See: src/types/index.ts for the full state transition documentation.
// See: Amendment #4 for the precise definition of ABANDONED.
enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EXPIRED
  ABANDONED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
}

enum TicketCategory {
  PAYMENT
  ACCOUNT
  TECHNICAL
  TEST_ISSUE
  QUESTION_ISSUE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// =============================================================================
// USER & AUTH
// =============================================================================

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  phone           String?
  passwordHash    String
  role            UserRole  @default(STUDENT)
  isEmailVerified Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?

  // Relations
  passwordResetTokens PasswordResetToken[]
  attempts            Attempt[]
  subscriptions       Subscription[]
  payments            Payment[]
  supportTickets      SupportTicket[]
  supportMessages     SupportMessage[]
  auditLogs           AuditLog[]
  createdTests        Test[]              @relation("TestCreator")
  authoredVersions    QuestionVersion[]   @relation("QuestionAuthor")

  // NextAuth adapter tables
  sessions            Session[]
  accounts            Account[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

// NextAuth v5 adapter tables
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique  // The actual token is sent to user; we store only the hash
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("password_reset_tokens")
}

// =============================================================================
// EXAM HIERARCHY
// =============================================================================

model Exam {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  subjects    Subject[]
  tests       Test[]

  @@map("exams")
}

model Subject {
  id           String   @id @default(uuid())
  examId       String
  name         String
  slug         String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)

  exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  topics    Topic[]
  questions Question[]

  @@unique([examId, slug])
  @@index([examId])
  @@map("subjects")
}

model Topic {
  id           String   @id @default(uuid())
  subjectId    String
  name         String
  slug         String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([subjectId, slug])
  @@index([subjectId])
  @@map("topics")
}

// =============================================================================
// TESTS
// =============================================================================

model Test {
  id               String     @id @default(uuid())
  examId           String
  title            String
  slug             String     @unique
  description      String?
  instructions     String?    @db.Text
  type             TestType
  status           TestStatus @default(DRAFT)
  durationMinutes  Int
  totalMarks       Decimal    @default(0) @db.Decimal(8, 2)
  negativeMarking  Decimal    @default(0) @db.Decimal(4, 2)
  randomizeQuestions Boolean  @default(false)
  randomizeOptions  Boolean   @default(false)
  showExplanations  Boolean   @default(true)
  createdBy        String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  publishedAt      DateTime?
  archivedAt       DateTime?

  exam      Exam          @relation(fields: [examId], references: [id])
  creator   User          @relation("TestCreator", fields: [createdBy], references: [id])
  questions TestQuestion[]
  attempts  Attempt[]

  @@unique([examId, slug])
  @@index([examId])
  @@index([status])
  @@index([type])
  @@index([createdBy])
  @@map("tests")
}

// =============================================================================
// QUESTIONS (Versioned)
// =============================================================================

// Question is a stable identifier — the actual content lives in QuestionVersion.
// When a question is edited after being used in a published/attempted test,
// a new QuestionVersion is created. The original version is never modified.
model Question {
  id             String   @id @default(uuid())
  subjectId      String
  topicId        String?
  currentVersion Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subject  Subject          @relation(fields: [subjectId], references: [id])
  topic    Topic?           @relation(fields: [topicId], references: [id])
  versions QuestionVersion[]
  testQuestions TestQuestion[]
  attemptQuestions AttemptQuestion[]
  attemptAnswers AttemptAnswer[]

  @@index([subjectId])
  @@index([topicId])
  @@index([isActive])
  @@map("questions")
}

// The actual question content. Immutable once referenced by an active/submitted attempt.
// Content fields (questionText, type, difficulty, explanation) are STRICTLY IMMUTABLE 
// after creation. `isActive` is lifecycle metadata only and does not affect history.
model QuestionVersion {
  id           String             @id @default(uuid())
  questionId   String
  version      Int
  questionText String             @db.Text
  questionType QuestionType       @default(SINGLE_CHOICE)
  difficulty   QuestionDifficulty @default(MEDIUM)
  explanation  String?            @db.Text
  isActive     Boolean            @default(true)
  createdBy    String
  createdAt    DateTime           @default(now())

  question        Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author          User             @relation("QuestionAuthor", fields: [createdBy], references: [id])
  options         QuestionOption[]
  testQuestions   TestQuestion[]
  attemptQuestions AttemptQuestion[]
  attemptAnswers  AttemptAnswer[]

  @@unique([questionId, version])
  @@index([questionId])
  @@index([createdBy])
  @@map("question_versions")
}

model QuestionOption {
  id                String @id @default(uuid())
  questionVersionId String
  optionKey         String // A, B, C, D, E, F
  optionText        String @db.Text
  isCorrect         Boolean @default(false)
  displayOrder      Int

  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)

  @@unique([questionVersionId, optionKey])
  @@index([questionVersionId])
  @@map("question_options")
}

// Association between a Test and a specific QuestionVersion.
// The questionVersionId locks which version of the question is used in this test.
model TestQuestion {
  id                String  @id @default(uuid())
  testId            String
  questionId        String
  questionVersionId String  // Locked to specific version when added to test
  questionOrder     Int
  marks             Decimal @db.Decimal(6, 2)
  negativeMarks     Decimal @default(0) @db.Decimal(6, 2)

  test            Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  question        Question        @relation(fields: [questionId], references: [id])
  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id])

  @@unique([testId, questionId])
  @@index([testId])
  @@index([questionId])
  @@index([questionVersionId])
  @@map("test_questions")
}

// =============================================================================
// ATTEMPTS (Exam sessions)
// =============================================================================

model Attempt {
  id               String        @id @default(uuid())
  userId           String
  testId           String
  status           AttemptStatus @default(IN_PROGRESS)
  startedAt        DateTime      @default(now())
  expiresAt        DateTime      // Server-authoritative deadline
  submittedAt      DateTime?
  score            Decimal?      @db.Decimal(8, 2)
  correctCount     Int?
  incorrectCount   Int?
  unansweredCount  Int?
  totalMarks       Decimal?      @db.Decimal(8, 2)
  percentage       Decimal?      @db.Decimal(5, 2)
  timeTakenSeconds Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user      User              @relation(fields: [userId], references: [id])
  test      Test              @relation(fields: [testId], references: [id])
  snapshot  AttemptSnapshot?
  questions AttemptQuestion[]
  answers   AttemptAnswer[]

  // One active attempt per user per test at a time.
  // This is enforced in application logic + here as a partial unique index.
  @@index([userId])
  @@index([testId])
  @@index([userId, testId, status])
  @@index([status, expiresAt]) // For auto-submission cron job
  @@map("attempts")
}

// Immutable snapshot of the test configuration and questions at attempt start time.
// Scoring ALWAYS reads from this snapshot, never from live question data.
// This ensures results are reproducible even after questions are edited.
//
// Amendment #1 compliance: SELECT FOR UPDATE locking during payment activation
// and submission uses Prisma $transaction with explicit isolation.
model AttemptSnapshot {
  id         String   @id @default(uuid())
  attemptId  String   @unique
  // Full test configuration at attempt creation time (JSON)
  testConfig Json
  // Full question data with options and correct answers (JSON)
  // NOTE: This contains correct answers — it is never sent to the client.
  // The server reads from this during scoring only.
  questionsSnapshot Json
  createdAt  DateTime @default(now())

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("attempt_snapshots")
}

// The ordered list of questions for this attempt.
// questionVersionId is locked at attempt creation — never changes.
model AttemptQuestion {
  id                String @id @default(uuid())
  attemptId         String
  questionId        String
  questionVersionId String // Exact version used in this attempt
  displayOrder      Int    // The order shown to this specific student (randomized if enabled)

  attempt         Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        Question        @relation(fields: [questionId], references: [id])
  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id])

  @@unique([attemptId, questionId])
  @@unique([attemptId, displayOrder])
  @@index([attemptId])
  @@index([questionId])
  @@index([questionVersionId])
  @@map("attempt_questions")
}

// Student's answer for a question in an attempt.
// Updated on every autosave. Idempotent upserts are safe.
model AttemptAnswer {
  id                String   @id @default(uuid())
  attemptId         String
  questionId        String
  questionVersionId String   // Version that was answered
  selectedOptionKey String?  // null = cleared/unanswered
  isMarkedForReview Boolean  @default(false)
  answeredAt        DateTime?
  updatedAt         DateTime @updatedAt

  attempt         Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        Question        @relation(fields: [questionId], references: [id])
  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([questionVersionId])
  @@map("attempt_answers")
}

// =============================================================================
// PAYMENTS & SUBSCRIPTIONS
// =============================================================================

// Payment reconciliation:
// Both the frontend callback and the Razorpay webhook update this record.
// A Prisma $transaction with SELECT ... FOR UPDATE (via raw SQL) ensures
// only one path activates the subscription in race conditions.
// See: Amendment #1 compliance in reconciliationService.ts.
model Payment {
  id                  String        @id @default(uuid())
  userId              String
  razorpayOrderId     String        @unique
  razorpayPaymentId   String?       @unique
  razorpaySignature   String?
  amountPaise         Int           // Amount in paise (₹49 = 4900)
  currency            String        @default("INR")
  status              PaymentStatus @default(CREATED)
  failureReason       String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  subscription Subscription?

  @@index([userId])
  @@index([razorpayOrderId])
  @@index([status])
  @@map("payments")
}

// Webhook deduplication: eventId has a UNIQUE constraint.
// If the same webhook arrives twice, the INSERT fails and the second
// delivery is a no-op (idempotent).
model WebhookEvent {
  id             String    @id @default(uuid())
  provider       String    @default("razorpay")
  eventId        String    @unique  // Razorpay's x-razorpay-event-id header
  eventType      String
  payload        Json
  processed      Boolean   @default(false)
  processedAt    DateTime?
  processingError String?
  createdAt      DateTime  @default(now())

  @@index([eventId])
  @@index([processed])
  @@map("webhook_events")
}

model Subscription {
  id         String             @id @default(uuid())
  userId     String
  paymentId  String?            @unique
  status     SubscriptionStatus @default(PENDING)
  startedAt  DateTime?
  expiresAt  DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("subscriptions")
}

// =============================================================================
// SUPPORT
// =============================================================================

model SupportTicket {
  id        String         @id @default(uuid())
  userId    String
  category  TicketCategory
  subject   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(MEDIUM)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  messages SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@map("support_tickets")
}

model SupportMessage {
  id         String   @id @default(uuid())
  ticketId   String
  senderId   String
  message    String   @db.Text
  isInternal Boolean  @default(false)  // Internal admin notes not shown to student
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id])

  @@index([ticketId])
  @@index([senderId])
  @@map("support_messages")
}

// =============================================================================
// AUDIT LOG
// =============================================================================

// Immutable audit trail for security-sensitive actions.
// Records are NEVER deleted — only appended.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String   // e.g., "ADMIN_PUBLISH_TEST", "PAYMENT_ACTIVATED"
  entityType String   // e.g., "Test", "Payment", "User"
  entityId   String?
  metadata   Json?    // Additional context — NEVER include secrets or passwords
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
